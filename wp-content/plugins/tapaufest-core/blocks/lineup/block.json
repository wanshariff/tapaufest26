{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tapaufest/lineup",
	"title": "Lineup",
	"category": "tapaufest",
	"icon": "groups",
	"description": "Artist cards with listen previews. Optional country and day filters and a poster view.",
	"textdomain": "tapaufest",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"attributes": {
		"limit": {
			"type": "number",
			"default": 0
		},
		"filters": {
			"type": "boolean",
			"default": true
		},
		"moreLink": {
			"type": "boolean",
			"default": false
		}
	},
	"editorScript": "tapaufest-blocks-editor",
	"style": "tapaufest-blocks",
	"render": "file:./render.php"
}
