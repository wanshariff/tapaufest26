{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tapaufest/vendors",
	"title": "Vendors",
	"category": "tapaufest",
	"icon": "store",
	"description": "WARUNG or PASAR vendor list.",
	"textdomain": "tapaufest",
	"supports": {
		"html": false,
		"align": false
	},
	"attributes": {
		"type": {
			"type": "string",
			"enum": [
				"warung",
				"pasar"
			],
			"default": "warung"
		}
	},
	"editorScript": "tapaufest-blocks-editor",
	"style": "tapaufest-blocks",
	"render": "file:./render.php"
}
