{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "kopi",
					"color": "#6F310B",
					"name": "Kopi brown"
				},
				{
					"slug": "kopi-deep",
					"color": "#4E2207",
					"name": "Kopi deep"
				},
				{
					"slug": "cili",
					"color": "#E33D07",
					"name": "Cili red"
				},
				{
					"slug": "cili-deep",
					"color": "#A82E05",
					"name": "Cili deep (text and buttons)"
				},
				{
					"slug": "paper",
					"color": "#F8DAA5",
					"name": "Paper cream"
				},
				{
					"slug": "paper-hi",
					"color": "#FFF2DA",
					"name": "Paper light"
				},
				{
					"slug": "paper-lo",
					"color": "#F1CC8E",
					"name": "Paper dark"
				},
				{
					"slug": "gold",
					"color": "#F2A93B",
					"name": "Golden yellow"
				},
				{
					"slug": "specs",
					"color": "#3D8BD0",
					"name": "Specs blue"
				},
				{
					"slug": "specs-deep",
					"color": "#2E6FA8",
					"name": "Specs deep"
				},
				{
					"slug": "ink",
					"color": "#1E1208",
					"name": "Ink"
				},
				{
					"slug": "muted",
					"color": "#5A3A20",
					"name": "Muted brown"
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "ink",
					"shadow": "5px 5px 0 #1E1208",
					"name": "Ink offset"
				},
				{
					"slug": "ink-small",
					"shadow": "3px 3px 0 #1E1208",
					"name": "Ink offset small"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "Huisea",
					"slug": "display",
					"fontFamily": "Huisea, \"Bagel Fat One\", \"Arial Black\", Impact, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Huisea",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/huisea-400.woff2"
							]
						}
					]
				},
				{
					"name": "Bagel Fat One",
					"slug": "display-alt",
					"fontFamily": "\"Bagel Fat One\", \"Arial Black\", Impact, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Bagel Fat One",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/bagel-fat-one-400.woff2"
							],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						},
						{
							"fontFamily": "Bagel Fat One",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/bagel-fat-one-400-latin-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						}
					]
				},
				{
					"name": "Archivo",
					"slug": "body",
					"fontFamily": "Archivo, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Archivo",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/archivo-variable.woff2"
							]
						},
						{
							"fontFamily": "Archivo",
							"fontWeight": "100 900",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/archivo-variable-italic.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small",
					"fluid": false
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Medium",
					"fluid": false
				},
				{
					"slug": "large",
					"size": "1.125rem",
					"name": "Large",
					"fluid": false
				},
				{
					"slug": "x-large",
					"size": "1.75rem",
					"name": "Extra large",
					"fluid": {
						"min": "1.5rem",
						"max": "1.75rem"
					}
				},
				{
					"slug": "xx-large",
					"size": "3.25rem",
					"name": "Section heading",
					"fluid": {
						"min": "2rem",
						"max": "3.25rem"
					}
				},
				{
					"slug": "huge",
					"size": "4.5rem",
					"name": "Page title",
					"fluid": {
						"min": "2.5rem",
						"max": "4.5rem"
					}
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"size": "0.5rem",
					"name": "XS"
				},
				{
					"slug": "30",
					"size": "1rem",
					"name": "S"
				},
				{
					"slug": "40",
					"size": "1.5rem",
					"name": "M"
				},
				{
					"slug": "50",
					"size": "clamp(2rem, 4vw, 3rem)",
					"name": "L"
				},
				{
					"slug": "60",
					"size": "clamp(2.5rem, 6vw, 4rem)",
					"name": "XL"
				}
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1120px"
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--kopi)",
			"text": "var(--wp--preset--color--paper)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.55"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0",
				"right": "max(16px, env(safe-area-inset-right, 0px))",
				"bottom": "0",
				"left": "max(16px, env(safe-area-inset-left, 0px))"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "currentColor"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.02",
					"letterSpacing": "0"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--huge)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--paper)",
					"text": "var(--wp--preset--color--ink)"
				},
				"border": {
					"width": "3px",
					"style": "solid",
					"color": "var(--wp--preset--color--ink)",
					"radius": "6px"
				},
				"shadow": "var(--wp--preset--shadow--ink)",
				"spacing": {
					"padding": {
						"top": "0.7em",
						"right": "1.3em",
						"bottom": "0.7em",
						"left": "1.3em"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "700",
					"fontSize": "0.9375rem",
					"lineHeight": "1.2"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--paper-hi)",
						"text": "var(--wp--preset--color--ink)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--ink)",
						"offset": "3px",
						"style": "solid",
						"width": "3px"
					}
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontSize": "0.9375rem",
					"fontWeight": "700"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-landing",
			"title": "Festival page (no title, full width)",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-screen",
			"title": "Festival screen (full page from festival data)",
			"postTypes": [
				"page"
			]
		}
	],
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
