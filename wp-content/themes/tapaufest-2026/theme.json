{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "kopi", "color": "#6F310B", "name": "Kopi brown" },
				{ "slug": "kopi-deep", "color": "#4E2207", "name": "Kopi deep" },
				{ "slug": "cili", "color": "#E33D07", "name": "Cili red" },
				{ "slug": "cili-deep", "color": "#B84A12", "name": "Cili deep" },
				{ "slug": "paper", "color": "#F8DAA5", "name": "Paper cream" },
				{ "slug": "paper-hi", "color": "#FFF2DA", "name": "Paper light" },
				{ "slug": "paper-lo", "color": "#F1CC8E", "name": "Paper dark" },
				{ "slug": "gold", "color": "#F2A93B", "name": "Golden yellow" },
				{ "slug": "specs", "color": "#3D8BD0", "name": "Specs blue" },
				{ "slug": "specs-deep", "color": "#2E6FA8", "name": "Specs deep" },
				{ "slug": "ink", "color": "#1E1208", "name": "Ink" },
				{ "slug": "muted", "color": "#8A5A33", "name": "Muted brown" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "ink", "shadow": "4px 4px 0 #1E1208", "name": "Ink offset" },
				{ "slug": "ink-small", "shadow": "2px 2px 0 #1E1208", "name": "Ink offset small" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "Lilita One",
					"slug": "display",
					"fontFamily": "\"Lilita One\", \"Arial Black\", Impact, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Lilita One",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/lilita-one-400.woff2" ]
						}
					]
				},
				{
					"name": "DM Sans",
					"slug": "body",
					"fontFamily": "\"DM Sans\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "DM Sans",
							"fontWeight": "100 1000",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/dm-sans-variable.woff2" ]
						},
						{
							"fontFamily": "DM Sans",
							"fontWeight": "100 1000",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/dm-sans-variable-italic.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Small", "fluid": false },
				{ "slug": "medium", "size": "1rem", "name": "Medium", "fluid": false },
				{ "slug": "large", "size": "1.125rem", "name": "Large", "fluid": false },
				{ "slug": "x-large", "size": "1.75rem", "name": "Extra large", "fluid": { "min": "1.5rem", "max": "1.75rem" } },
				{ "slug": "xx-large", "size": "3.25rem", "name": "Section heading", "fluid": { "min": "2rem", "max": "3.25rem" } },
				{ "slug": "huge", "size": "4.5rem", "name": "Page title", "fluid": { "min": "2.5rem", "max": "4.5rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "size": "0.5rem", "name": "XS" },
				{ "slug": "30", "size": "1rem", "name": "S" },
				{ "slug": "40", "size": "1.5rem", "name": "M" },
				{ "slug": "50", "size": "clamp(2rem, 4vw, 3rem)", "name": "L" },
				{ "slug": "60", "size": "clamp(2.5rem, 6vw, 4rem)", "name": "XL" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1120px"
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--kopi)",
			"text": "var(--wp--preset--color--paper)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.55"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0",
				"right": "max(16px, env(safe-area-inset-right, 0px))",
				"bottom": "0",
				"left": "max(16px, env(safe-area-inset-left, 0px))"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.05",
					"letterSpacing": "0.02em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--paper)",
					"text": "var(--wp--preset--color--ink)"
				},
				"border": {
					"width": "3px",
					"style": "solid",
					"color": "var(--wp--preset--color--ink)",
					"radius": "999px"
				},
				"shadow": "var(--wp--preset--shadow--ink)",
				"spacing": {
					"padding": { "top": "0.7em", "right": "1.3em", "bottom": "0.7em", "left": "1.3em" }
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "700",
					"fontSize": "0.9375rem",
					"lineHeight": "1.2"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--paper-hi)",
						"text": "var(--wp--preset--color--ink)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--specs)",
						"offset": "3px",
						"style": "solid",
						"width": "3px"
					}
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "0.9375rem", "fontWeight": "700" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--ink)" }
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-landing",
			"title": "Festival page (no title, full width)",
			"postTypes": [ "page" ]
		}
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
